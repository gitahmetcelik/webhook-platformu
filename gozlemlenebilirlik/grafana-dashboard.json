{
  "title": "Webhook Platformu",
  "uid": "webhook-platformu",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Teslimat başarı oranı (5dk)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(webhook_teslimat_sonuc_total{sonuc=\"basarili\"}[5m])) / clamp_min(sum(rate(webhook_teslimat_sonuc_total[5m])), 0.0001)",
          "legendFormat": "başarı oranı"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Açık devre sayısı",
      "description": "Devresi açık, yani şu an teslimat kabul etmeyen endpoint sayısı.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "refId": "A", "expr": "sum(webhook_devre_acik)", "legendFormat": "açık devre" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kuyruk derinliği",
      "description": "Motorun öncelik kuyrukları ve ölü mektup kutusu (gorev-motoru metriği).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "gorev_kuyruk_derinlik", "legendFormat": "{{kuyruk}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Teslimat süresi (p50 / p95)",
      "description": "Müşteri endpoint'ine yapılan tek bir HTTP teslimat denemesinin süresi.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(webhook_teslimat_suresi_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(webhook_teslimat_suresi_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Teslimat sonuçları (sn başına)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(webhook_teslimat_sonuc_total[5m])) by (sonuc)",
          "legendFormat": "{{sonuc}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Motor: yeniden deneme hızı",
      "description": "Motorun retry merdivenine düşen görevler (gorev-motoru metriği).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gorev_yeniden_deneme_total[5m])) by (tip)",
          "legendFormat": "{{tip}}"
        }
      ]
    }
  ]
}
