<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.webhookplatformu</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- motor-spring-starter artik GitHub Packages'ta (bkz gorev-motoru Faz 5.0) - local .m2'ye
         elle kurulmasina gerek yok. Erisim icin ~/.m2/settings.xml'de "github-gorev-motoru" id'li
         bir <server> girisi (username = GitHub kullanici adi, password = read:packages yetkili
         PAT) gerekir - repo README'sinde adimlar var. -->
    <repositories>
        <repository>
            <id>github-gorev-motoru</id>
            <url>https://maven.pkg.github.com/gitahmetcelik/gorev-motoru</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Motor: yürütme katmanı (retry+backoff, DLQ, idempotency, öncelik kuyrukları) -->
        <dependency>
            <groupId>com.gorevplatformu</groupId>
            <artifactId>motor-spring-starter</artifactId>
            <version>0.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Motor starter'ı flyway-core/flyway-database-postgresql getirmiyor (bkz
             gorev-motoru README-motor.md, Faz 0 bulgusu) - burada açıkça ekleniyor. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
