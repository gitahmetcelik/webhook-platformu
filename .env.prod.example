# docker-compose.prod.yml icin. `cp .env.prod.example .env.prod` yapip DOLDURUN.
# .env.prod repoya commit EDILMEZ (.gitignore'da).

POSTGRES_DB=webhook_platformu
POSTGRES_USER=webhook
POSTGRES_PASSWORD=DEGISTIR_guclu_bir_sifre

RABBITMQ_DEFAULT_USER=webhook
RABBITMQ_DEFAULT_PASS=DEGISTIR_guclu_bir_sifre

# Endpoint imza secret'larini sifrelemek icin base64 kodlu 32 baytlik anahtar. ZORUNLU -
# uretmek icin:  openssl rand -base64 32
# DIKKAT: bu anahtar degisirse kayitli endpoint secret'lari cozulemez hale gelir.
WEBHOOK_SIFRELEME_ANAHTARI=

# Dashboard'un tarayicidan backend'e erisecegi adres. Ayni makinede calisiyorsa localhost;
# sunucuda ise sunucunun genel adresi (orn. https://api.ornek.com).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend'in CORS'ta kabul edecegi origin(ler) - dashboard'un adresiyle eslesmeli.
WEBHOOK_IZINLI_ORIGINLER=http://localhost:3000

# Host'ta yayinlanacak portlar.
BACKEND_PORT=8080
FRONTEND_PORT=3000
TEST_ALICI_PORT=4000

# Devre kesici esigi (ardisik kalici hata). DEMO.md senaryosu icin 3 yapin.
WEBHOOK_DEVRE_ESIGI=20

# Opsiyonel: seed'in bastigi "endpoint duz secret" (whsec_...) degerini buraya yazarsaniz
# test-alici gelen imzayi da dogrular. Bos birakilirsa imza kontrol edilmez.
TEST_ALICI_WEBHOOK_SECRET=

# motor-spring-starter GitHub Packages'tan cekildigi icin build sirasinda gerekli (bkz README).
# Windows'ta mutlak yol verin, orn: C:/Users/KULLANICI/.m2/settings.xml
MAVEN_SETTINGS_PATH=~/.m2/settings.xml
